MATAFUEGOS_DEMO_PASSWORD=
SUCURSAL_PASSWORD_PREFIX=mto

# Microsoft Entra ID / OpenID Connect
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
