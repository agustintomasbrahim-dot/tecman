SUCURSAL_LOCAL_LOGIN_ENABLED=false
# La app de Entra debe tener admin consent para Microsoft Graph: GroupMember.Read.All.
# También se aceptan estos alias si ya vienen configurados en Azure/Render:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
SESSION_LIFETIME_MINUTES=480
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Portal Logística: Dabra Central es Microsoft-only y se autoriza exclusivamente a
# hdiosque@grupodexter.com.ar. Las allowlists/grupos existentes siguen disponibles
# para Garín y Compras; las variables DABRA legacy ya no conceden ese rol.
# El login local permanece apagado por defecto y nunca habilita el rol Dabra.
LOGISTICA_DABRA_USER=dabra
LOGISTICA_DABRA_PASSWORD=
LOGISTICA_GARIN_USER=garin
LOGISTICA_GARIN_PASSWORD=
LOGISTICA_LOCAL_USERS=
LOGISTICA_LOCAL_LOGIN_ENABLED=false
LOGISTICA_ENTRA_DABRA_EMAILS=
LOGISTICA_ENTRA_GARIN_EMAILS=
LOGISTICA_ENTRA_COMPRAS_EMAILS=
LOGISTICA_ENTRA_DABRA_GROUP_ID=
LOGISTICA_ENTRA_GARIN_GROUP_ID=
LOGISTICA_ENTRA_COMPRAS_GROUP_ID=
# Pedidos simulados sólo para Dabra, en almacenamiento aislado.
LOGISTICA_PORTAL_TEST_MODE=true
# Sucursales reales: mantener false hasta una habilitación explícita.
LOGISTICA_INSUMOS_SUCURSALES_ENABLED=false
# Sólo pruebas/demos locales: registra éxito sin abrir una conexión SMTP.
LOGISTICA_SMTP_MOCK=false

# PostgreSQL - dejar vacío para usar JSON local
DATABASE_URL=
